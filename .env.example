# ============================================
# FLEX-VRP — Environment Configuration
# ============================================
# Copy file này thành .env:  cp .env.example .env
# Docker sẽ tự động copy khi khởi chạy lần đầu.
# ============================================

APP_NAME=FLEX-VRP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ─────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (MySQL via Docker) ─────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=flexvrp
DB_USERNAME=flexvrp
DB_PASSWORD=flexvrp_secret

# ── Session ─────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Queue & Cache (Redis via Docker) ────────
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Redis ───────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (Development) ─────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@flexvrp.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Vite ────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Laravel Reverb (WebSocket) ──────────────
# Cấu hình ở Phase 4 khi tích hợp Reverb
# REVERB_APP_ID=flexvrp
# REVERB_APP_KEY=flexvrp-key
# REVERB_APP_SECRET=flexvrp-secret
# REVERB_HOST=reverb
# REVERB_PORT=8080

# ── Python Solver Service ───────────────────
# Cấu hình ở Phase 3 khi tích hợp Python Solver
# SOLVER_API_URL=http://solver:8000
# SOLVER_API_TIMEOUT=300

# ── External APIs ──────────────────────────
# Cấu hình ở Phase 5
# OPENWEATHER_API_KEY=
# MAPBOX_ACCESS_TOKEN=
# OPENROUTER_API_KEY=

# ── n8n Workflow ────────────────────────────
# Cấu hình ở Phase 3 khi tích hợp n8n
# N8N_WEBHOOK_URL=http://n8n:5678
